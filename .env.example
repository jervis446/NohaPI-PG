# The address customers and your phone use to reach this server. Use https in production.
PUBLIC_URL=https://pay.example.com
PORT=8080
# Where the SQLite database lives. Back this file up.
DB_PATH=data/noha-pay.db
# Minutes a customer has to pay, and how long after that a late bank alert still counts.
ORDER_MINUTES=15
GRACE_MINUTES=30
# Days to keep the raw text of bank alerts before deleting it.
ALERT_KEEP_DAYS=30
# Set to 1 when running behind a proxy such as Cloudflare or nginx, so rate limits see the real IP.
TRUST_PROXY=0
# Comma-separated list replacing the built-in bank email domains (optional).
# BANK_EMAIL_DOMAINS=hdfcbank.net,icicibank.com
# Only for local testing: allow webhooks to http:// and private addresses.
# ALLOW_PRIVATE_WEBHOOKS=1
